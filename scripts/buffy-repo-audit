#!/usr/bin/env python3
"""Read-only daily snapshots for up to 20 explicitly known repositories."""
import json, os, subprocess
from datetime import datetime, timezone

BASE = os.path.expanduser('~/.config/buffy')
TARGETS = os.path.join(BASE, 'targets.json')
STATE = os.path.join(BASE, 'repo-audit.json')

def run(cmd, cwd=None, timeout=30):
    try:
        p = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, '', str(e)

def main():
    with open(TARGETS, encoding='utf-8') as f: targets = json.load(f)
    repos = targets.get('repositories', {})
    state = {'updated_at': datetime.now(timezone.utc).isoformat(), 'repositories': {}}
    for name, path in list(repos.items())[:20]:
        if not os.path.isdir(os.path.join(path, '.git')):
            state['repositories'][name] = {'path': path, 'status': 'not-local'}
            continue
        rc, branch, _ = run(['git', 'branch', '--show-current'], path)
        _, head, _ = run(['git', 'log', '-1', '--format=%H%x09%aI%x09%s'], path)
        _, status, _ = run(['git', 'status', '--short'], path)
        _, recent, _ = run(['git', 'log', '-10', '--format=%H%x09%aI%x09%s'], path)
        state['repositories'][name] = {'path': path, 'status': 'audited', 'branch': branch,
            'head': head, 'dirty': bool(status), 'changes': status.splitlines()[:100],
            'recent_commits': recent.splitlines()}
    tmp = STATE + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f: json.dump(state, f, ensure_ascii=False, indent=2); f.write('\n')
    os.replace(tmp, STATE)
    print(json.dumps(state, ensure_ascii=False, indent=2))

if __name__ == '__main__': main()
