#!/usr/bin/env python3
"""
Buffy - Voice activated terminal assistant
Usage: 
  buffy          → Start voice service
  buffy chat     → Open terminal chat
  buffy stop     → Stop all
  buffy status   → Show status
"""
import subprocess, sys, os, signal, time, json

CHAT = os.path.expanduser("~/.local/bin/buffy-chat")
SERVER = os.path.expanduser("~/.local/bin/buffy-server")
VOICE = os.path.expanduser("~/.local/bin/buffy-voice-ui")
WORK = os.path.expanduser("~/novinpendar")
PIDS = os.path.expanduser("~/.buffy-pids.json")

def load_pids():
    if os.path.exists(PIDS):
        with open(PIDS) as f: return json.load(f)
    return {}

def save_pids(pids):
    with open(PIDS, 'w') as f: json.dump(pids, f)

def kill_all():
    for name, pid in load_pids().items():
        try: os.kill(pid, signal.SIGTERM)
        except: pass
    save_pids({})

def start_proc(name, cmd):
    p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    pids = load_pids()
    pids[name] = p.pid
    save_pids(pids)
    return p

def main():
    cmd = sys.argv[1].lower() if len(sys.argv) > 1 else "voice"
    
    if cmd in ["chat", "چت"]:
        os.execv(CHAT, [CHAT])
    
    elif cmd in ["voice", "صدا", "start"]:
        print("🎙️ Starting Buffy Voice System...")
        kill_all()
        start_proc("server", [sys.executable, SERVER])
        time.sleep(1)
        start_proc("voice", [sys.executable, VOICE])
        print("✅ Buffy is listening!")
        print("   Say 'برو چت' → Terminal opens!")
        print("   Ctrl+C to stop")
        try:
            while True: time.sleep(1)
        except KeyboardInterrupt:
            kill_all()
            print("👋 Bye!")
    
    elif cmd in ["stop", "توقف"]:
        kill_all()
        print("👋 Stopped!")
    
    elif cmd in ["status", "وضعیت"]:
        print("\n📊 Buffy Status:")
        for n, pid in load_pids().items():
            try:
                os.kill(pid, 0)
                print(f"  ✅ {n}: Running")
            except:
                print(f"  ❌ {n}: Stopped")
        print("\n🩺 Capability diagnostics:")
        subprocess.run([os.path.expanduser("~/.local/bin/buffy-doctor")])

    elif cmd in ["learn", "یادگیری"]:
        subprocess.run([os.path.expanduser("~/.local/bin/buffy-learning"), "status"])

    elif cmd in ["lesson", "درس"]:
        subprocess.run([os.path.expanduser("~/.local/bin/buffy-learning"), "next"])

    elif cmd in ["sources", "منابع"]:
        subprocess.run([os.path.expanduser("~/.local/bin/buffy-sources"), "status"])
    
    else:
        print("Usage: buffy [chat|voice|stop|status|learn|lesson|sources]")

if __name__ == "__main__":
    main()
