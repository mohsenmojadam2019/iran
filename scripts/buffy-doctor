#!/usr/bin/env python3
"""Read-only capability report for Buffy."""
import json
import os
import shutil
import subprocess


def run(args, timeout=8):
    try:
        result = subprocess.run(args, text=True, capture_output=True, timeout=timeout)
        return {"ok": result.returncode == 0, "code": result.returncode,
                "output": (result.stdout or result.stderr).strip()[:1000]}
    except Exception as exc:
        return {"ok": False, "error": str(exc)}


def main():
    tools = ["codex", "git", "gh", "ssh", "docker", "systemctl", "xdg-open",
             "google-chrome", "firefox", "adb"]
    report = {
        "tools": {name: shutil.which(name) for name in tools},
        "github_cli": run(["gh", "auth", "status"]) if shutil.which("gh") else None,
        "ssh_server": run(["ssh", "-o", "BatchMode=yes", "-o",
                           "ConnectTimeout=5", "server", "true"]),
        "android": run(["adb", "devices", "-l"]) if shutil.which("adb") else None,
        "targets_file": os.path.exists(os.path.expanduser("~/.config/buffy/targets.json")),
    }
    print(json.dumps(report, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
