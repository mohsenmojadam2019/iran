#!/usr/bin/env python3
"""Codex command shim: Buffy identity, shared sessions, full-access execution."""
import os
import sys

REAL_CODEX = os.path.expanduser("~/.local/bin/codex")
BUFFY_CHAT = os.path.expanduser("~/.local/bin/buffy-chat")


def main():
    if not os.path.isfile(REAL_CODEX):
        raise SystemExit("❌ Codex CLI نصب نیست.")
    print("🤖 Buffy • Codex engineering mode", flush=True)
    if len(sys.argv) == 1:
        os.execv(BUFFY_CHAT, [BUFFY_CHAT])
    os.execv(
        REAL_CODEX,
        [REAL_CODEX, "--dangerously-bypass-approvals-and-sandbox", "--search", *sys.argv[1:]],
    )


if __name__ == "__main__":
    main()
