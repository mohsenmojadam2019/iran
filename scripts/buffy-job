#!/usr/bin/env python3
"""Manage bounded long-running user jobs through systemd."""

from __future__ import annotations

import argparse
import os
import re
import subprocess


PREFIX = "buffy-job-"


def unit(name: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,47}", name):
        raise ValueError("نام job باید کوتاه و شامل حروف، عدد، خط تیره یا زیرخط باشد.")
    return PREFIX + name


def run(command):
    return subprocess.run(command, text=True, check=False)


def parse():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    start = sub.add_parser("start")
    start.add_argument("--name", required=True)
    start.add_argument("command", nargs=argparse.REMAINDER)
    for action in ("status", "logs", "stop"):
        item = sub.add_parser(action)
        item.add_argument("name")
    sub.add_parser("list")
    return parser.parse_args()


def main():
    args = parse()
    if args.action == "list":
        return run(["systemctl", "--user", "list-units", f"{PREFIX}*", "--all", "--no-pager"]).returncode
    name = unit(args.name)
    if args.action == "start":
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if not command:
            raise ValueError("فرمان job خالی است.")
        invocation = ["systemd-run", "--user", "--collect", f"--unit={name}",
                      f"--property=WorkingDirectory={os.getcwd()}", "--", *command]
        return run(invocation).returncode
    if args.action == "status":
        return run(["systemctl", "--user", "status", name, "--no-pager"]).returncode
    if args.action == "logs":
        return run(["journalctl", "--user", "-u", name, "-n", "100", "--no-pager"]).returncode
    return run(["systemctl", "--user", "stop", name]).returncode


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        raise SystemExit(f"error: {error}")
