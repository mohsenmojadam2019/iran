#!/usr/bin/env python3
"""Discover and launch the local ComfyUI installation."""
import json
import os
import subprocess
import sys
import time
import urllib.request

ROOT = os.path.expanduser("~/ComfyUI")
URL = "http://127.0.0.1:8188"
LAUNCHER = os.path.expanduser("~/start-comfyui.sh")
WORKFLOWS = os.path.join(ROOT, "user", "default", "workflows")
PORTABLE = "/media/god/TOSHIBA-1TB/ComfyUI_windows_portable"


def health():
    try:
        with urllib.request.urlopen(f"{URL}/system_stats", timeout=2) as response:
            return response.status == 200
    except Exception:
        return False


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == "status":
        print(json.dumps({"running": health(), "url": URL, "root": ROOT,
                          "portable_assets": PORTABLE,
                          "workflows": WORKFLOWS}, ensure_ascii=False, indent=2))
    elif command == "start":
        if not health():
            log = open(os.path.expanduser("~/.local/state/buffy-comfyui.log"), "ab")
            subprocess.Popen([LAUNCHER], cwd=ROOT, stdin=subprocess.DEVNULL,
                             stdout=log, stderr=subprocess.STDOUT,
                             start_new_session=True)
        print(URL)
    elif command == "open":
        if not health():
            raise SystemExit("❌ ComfyUI اجرا نیست; ابتدا buffy-comfyui start")
        os.execvp("xdg-open", ["xdg-open", URL])
    elif command == "launch":
        if not os.path.isdir(PORTABLE):
            raise SystemExit("❌ دیسک یا پوشه ComfyUI_windows_portable در دسترس نیست.")
        if not health():
            os.makedirs(os.path.expanduser("~/.local/state"), exist_ok=True)
            log = open(os.path.expanduser("~/.local/state/buffy-comfyui.log"), "ab")
            subprocess.Popen([LAUNCHER], cwd=ROOT, stdin=subprocess.DEVNULL,
                             stdout=log, stderr=subprocess.STDOUT,
                             start_new_session=True)
            for _ in range(90):
                if health():
                    break
                time.sleep(1)
        if not health():
            raise SystemExit("❌ ComfyUI تا ۹۰ ثانیه آماده نشد؛ لاگ: ~/.local/state/buffy-comfyui.log")
        subprocess.Popen(["xdg-open", URL], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        print("✅ ComfyUI با مدل‌های ComfyUI_windows_portable باز شد.")
    elif command == "workflows":
        for name in sorted(os.listdir(WORKFLOWS)) if os.path.isdir(WORKFLOWS) else []:
            if name.endswith(".json"):
                print(os.path.join(WORKFLOWS, name))
    else:
        raise SystemExit("Usage: buffy-comfyui [status|start|open|launch|workflows]")


if __name__ == "__main__":
    main()
